# ---- Razorpay (TEST MODE ONLY) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# base64 of "KEY_ID:KEY_SECRET" — used for the remote MCP server
RAZORPAY_MERCHANT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Database ----
DATABASE_URL=postgresql+psycopg2://postgres:pramaan@localhost:5432/pramaan

# ---- Buyer agent LLM ----
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Mandate signing keys (generated by scripts/generate_keys.py; do NOT commit real keys) ----
USER_SIGNING_KEY_PATH=./secrets/user_ed25519.key
MERCHANT_SIGNING_KEY_PATH=./secrets/merchant_ed25519.key
# Directory the control plane's Keyring loads PUBLIC keys from (*.pub + *.id
# sidecars written by the same script). Defaults to ./secrets if unset.
MANDATE_KEYRING_DIR=./secrets

# ---- App ----
ENV=development
